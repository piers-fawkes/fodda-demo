# ══════════════════════════════════════════════════════════════════
# Fodda Sandbox — Environment Variables
# Per Managed Agents Policy §3: every repo must maintain an
# .env.example that documents all required secrets.
# ══════════════════════════════════════════════════════════════════

# ── Core ────────────────────────────────────────────────────────
# The backend proxies queries to this URL
FODDA_API_URL=https://api.fodda.ai
# App frontend URL (used for magic-link emails, Stripe redirects)
APP_URL=https://app.fodda.ai
# Server port (Cloud Run sets this automatically)
PORT=8080

# ── Gemini / AI ─────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Airtable ────────────────────────────────────────────────────
AIRTABLE_PAT=
AIRTABLE_BASE_ID=
# CE (Expert Graph) Airtable — separate PAT for cross-repo ingestion
AIRTABLE_CE_PAT=

# ── MCP Server ──────────────────────────────────────────────────
# Shared secret for HMAC verification between sandbox ↔ MCP
FODDA_MCP_SECRET=
# Internal service key — skips decrementCredits() for internal calls
FODDA_INTERNAL_API_KEY=

# ── Auth & Cron ─────────────────────────────────────────────────
# Secret for Cloud Scheduler cron endpoints (/api/cron/*)
CRON_SECRET=

# Clerk Authentication (Register at clerk.com)
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# ── Stripe Billing ──────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Email (Nodemailer / Gmail fallback) ─────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
# Resend API (primary email provider — overrides Nodemailer when set)
RESEND_API_KEY=

# ── Slack (Content Gap Reports → #fodda-research) ──────────────
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# ── Google Cloud (Expert Graph PDF ingestion) ───────────────────
# Base64-encoded service account key JSON
GOOGLE_SERVICE_ACCOUNT_KEY=

# ── Skills — Auth tokens for third-party skill MCP servers ──────
# Pattern: SKILL_TOKEN_{SKILL_ID_UPPERCASE}
# Adding a new skill: add the Airtable row + set the env var — zero code changes
SKILL_TOKEN_PARALOGY=
SKILL_TOKEN_IGLOO=

# ── Optional / Development ──────────────────────────────────────
# Set to any value to send emails in non-production environments
# FORCE_EMAIL=
# Override the default MCP base URL (default: https://mcp.fodda.ai)
# MCP_BASE_URL=
